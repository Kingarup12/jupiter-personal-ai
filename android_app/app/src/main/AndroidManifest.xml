<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Live screen sharing keeps the user's own Live conversation audible while they show another app:
         the screen-share foreground service (started only from a user tap + system consent) also carries the
         microphone type. Nothing records in the background without that visible, stoppable notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Reminders the user explicitly asks for: shown as notifications (runtime permission on Android 13+),
         re-armed after a restart, and exact only when the user allows exact alarms (inexact otherwise). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Jupiter in-app calls (marker 172): an incoming Jupiter call may be shown full screen over the lock screen.
         On Android 14+ the user controls this in Settings; without it the call is a heads-up notification. Jupiter
         never changes the ringer, volume, Do Not Disturb or the phone's ringtone. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Marker 197: optional floating mascot that follows the desktop phone agent; the user grants it in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- REQUEST_INSTALL_PACKAGES intentionally NOT declared.
         Jupiter never installs packages itself: updates are delivered by opening the
         trusted versioned Jupiter APK URL in the user's browser, and the Android
         Package Installer performs the install under explicit user confirmation.
         Declaring an unused package-install capability is a Play Protect risk signal. -->

    <!-- Marker 199: "open WhatsApp" finds installed apps through their launcher entries only. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowAudioPlaybackCapture="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Jupiter">
        <!-- Full-screen incoming Jupiter call: only the OS opens it (no intent filter), over the lock screen, with no
             private content; answering requires unlocking. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Jupiter" />
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".JupiterPlaybackCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".JupiterScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
        <!-- Only system broadcasts reach this receiver; its own alarms use an explicit, immutable intent. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Marker 197: only the ADB shell / system hold DUMP, so only the Jupiter desktop host (over ADB) can drive the
             phone-agent mascot. -->
        <receiver
            android:name=".JupiterMascotReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.arupbairagya.jupiter.MASCOT" />
            </intent-filter>
        </receiver>
        <!-- Decline from the notification and the finite ring timeout: explicit intents only, never exported. -->
        <receiver
            android:name=".JupiterCallReceiver"
            android:exported="false" />
        <!-- Free background ringing via Firebase Cloud Messaging (inactive until the Firebase app ids are built in). -->
        <service
            android:name=".JupiterMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
